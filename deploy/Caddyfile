# 引力矩阵 · 容器入口反代（Caddy）
# 浏览器只访问一个源（${PORT}）：/api /ws 转发后端 uvicorn，其余转发前端 next start。
# reverse_proxy 自动处理 WebSocket 升级，无需额外配置。

{$PORT:10000} {
	encode gzip

	handle /api/* {
		reverse_proxy 127.0.0.1:8000
	}
	handle /ws/* {
		reverse_proxy 127.0.0.1:8000
	}
	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
